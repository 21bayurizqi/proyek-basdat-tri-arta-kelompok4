# ==============================================================================
# Contoh Konfigurasi Environment Variables — PT Tri Arta Konstruksi (SCM & CRM)
# Salin file ini menjadi `.env` untuk pengujian lokal, atau isi langsung di
# dashboard Variables pada Railway. Jangan pernah commit file `.env` ke Git.
# ==============================================================================

# OPSI 1 (Direkomendasikan untuk Railway + Neon.tech): Connection String Lengkap
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@ep-your-neon-host.aws.neon.tech:5432/neondb?sslmode=require

# OPSI 2: Variabel Terpisah (dipakai bila DATABASE_URL tidak diset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_scm_tri_arta
DB_USER=postgres
DB_PASS=your_password_here
DB_SSLMODE=prefer

